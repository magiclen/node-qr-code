{
    "name": "magic-qr-code",
    "version": "5.0.0",
    "description": "Encode QR Code, Micro QR Code and rMQR symbols, and render them as SVG images, by using N-API.",
    "keywords": [
        "Micro QR Code",
        "QR Code",
        "QR Code Generator",
        "SVG",
        "node.js",
        "rMQR"
    ],
    "homepage": "https://magiclen.org/node-qrcode/",
    "bugs": {
        "url": "https://github.com/magiclen/node-qr-code/issues"
    },
    "license": "MIT",
    "author": "Magic Len",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magiclen/node-qr-code.git"
    },
    "files": [
        "lib",
        "src/**/*.rs",
        "build.rs",
        "Cargo.toml",
        "Cargo.lock"
    ],
    "type": "module",
    "types": "./lib/index.d.ts",
    "exports": "./lib/index.js",
    "scripts": {
        "test": "tsx --test",
        "clean": "rimraf lib native",
        "build": "npm run clean && npm run install && tsc -p tsconfig.build.json",
        "build:watch": "npm run build -- -w",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "knip": "knip",
        "check": "npm run lint && npm run format:check && npm run knip",
        "prepare": "node setup-git-hooks.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm run test",
        "install": "napi build --release --platform --output-dir native --js index.cjs --dts index.d.cts --format commonjs -- --locked"
    },
    "dependencies": {
        "@napi-rs/cli": "^3.10.6"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "knip": "^6.39.0",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2003",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24"
    }
}
